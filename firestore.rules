rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function residentPath(uid) {
      return /databases/$(database)/documents/residents/$(uid);
    }

    // Tener cuenta de Auth no alcanza: hay que estar dado de alta en residents.
    function isResident() {
      return isSignedIn() && exists(residentPath(request.auth.uid));
    }

    function isAdmin() {
      return isResident() && get(residentPath(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function createdByMe() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function keepsCreator() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    // Un residente solo puede cambiar quién hace una guardia si en el mismo
    // batch queda confirmado un cambio (swap) de esa guardia del que es parte.
    function backedBySwap(shiftId) {
      let swap = getAfter(/databases/$(database)/documents/swaps/$(request.resource.data.swapId)).data;
      return swap.shiftId == shiftId
        && swap.status == 'confirmado'
        && request.resource.data.actualResidentId == swap.toResidentId
        && (isSelf(swap.toResidentId) || isSelf(swap.fromResidentId));
    }

    // El rol vive acá: nadie puede auto-promoverse a admin.
    // Solo las residentes dadas de alta ven la lista (una cuenta de Auth sin
    // perfil solo puede leer el suyo, que no existe).
    match /residents/{uid} {
      allow read: if isResident() || isSelf(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSelf(uid) && onlyChanged(['name', 'shortName', 'email', 'birthday', 'lastSeenAt', 'passwordChangedAt']));
    }

    match /monthConfigs/{id} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    match /calendarDays/{id} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    match /scheduleDrafts/{id} {
      allow read, write: if isAdmin();
    }

    match /shifts/{id} {
      allow read: if isResident();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isResident() && onlyChanged(['actualResidentId', 'swapId', 'updatedAt']) && backedBySwap(id))
        || (isSelf(resource.data.actualResidentId) && onlyChanged(['slept', 'updatedAt']));
    }

    // Pedidos: los ve todo el grupo. Cada una maneja los suyos mientras están
    // pendientes; las admins pueden cargarlos en nombre de otra persona.
    match /requests/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && (request.resource.data.residentId == request.auth.uid || isAdmin())
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.status == 'pendiente';
      allow update: if isAdmin() || (
        isSelf(resource.data.residentId)
        && request.resource.data.residentId == resource.data.residentId
        && resource.data.status == 'pendiente'
        && request.resource.data.status == 'pendiente'
      );
      allow delete: if isAdmin() || (isSelf(resource.data.residentId) && resource.data.status == 'pendiente');
    }

    // Feedback post-guardia (doc id = id de la guardia): solo autor + admins.
    // Toda query de una no-admin tiene que filtrar por su residentId.
    match /feedback/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
      allow create: if isResident() && request.resource.data.residentId == request.auth.uid;
      allow update: if isAdmin() || (
        isSelf(resource.data.residentId) && request.resource.data.residentId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Último momento para ofrecer/tomar una guardia: el día 20 del mes anterior
    // a la guardia, a las 24 h de Argentina (= día 21, 03:00 UTC).
    function offerDeadline(dateStr) {
      let p = dateStr.split('-');
      let y = int(p[0]);
      let m = int(p[1]);
      return (m == 1 ? timestamp.date(y - 1, 12, 21) : timestamp.date(y, m - 1, 21)) + duration.value(3, 'h');
    }

    function shiftPath(shiftId) {
      return /databases/$(database)/documents/shifts/$(shiftId);
    }

    // Un cambio ya confirmado solo se puede crear tomando una guardia ofrecida.
    function swapFromOffer() {
      let o = getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data;
      return o.status == 'tomada'
        && o.takenBy == request.auth.uid
        && request.resource.data.toResidentId == request.auth.uid
        && request.resource.data.fromResidentId == o.fromResidentId
        && request.resource.data.shiftId == o.shiftId
        && get(shiftPath(o.shiftId)).data.actualResidentId == o.fromResidentId;
    }

    // Una de las dos patas de un intercambio aceptado (la crea quien acepta, en el
    // mismo batch): sin deuda y con las guardias todavía en manos de cada una.
    function swapFromTrade() {
      let t = getAfter(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data;
      let s = request.resource.data;
      return t.status == 'aceptado'
        && t.toResidentId == request.auth.uid
        && s.generatesDebt == false
        && ((s.shiftId == t.fromShiftId && s.fromResidentId == t.fromResidentId && s.toResidentId == t.toResidentId
              && get(shiftPath(t.fromShiftId)).data.actualResidentId == t.fromResidentId)
          || (s.shiftId == t.toShiftId && s.fromResidentId == t.toResidentId && s.toResidentId == t.fromResidentId
              && get(shiftPath(t.toShiftId)).data.actualResidentId == t.toResidentId));
    }

    // Intercambio directo: una propone "te doy mi guardia por la tuya"; la otra
    // acepta (y en el mismo batch se mueven las dos guardias) o rechaza. Hasta
    // el día 20 del mes anterior a cada guardia, como las ofertas.
    match /trades/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && request.resource.data.fromResidentId == request.auth.uid
        && request.resource.data.toResidentId != request.auth.uid
        && request.resource.data.status == 'propuesto'
        && request.resource.data.notifiedNew == false
        && request.resource.data.notifiedResolved == false
        && get(shiftPath(request.resource.data.fromShiftId)).data.actualResidentId == request.auth.uid
        && get(shiftPath(request.resource.data.fromShiftId)).data.date == request.resource.data.fromDate
        && get(shiftPath(request.resource.data.toShiftId)).data.actualResidentId == request.resource.data.toResidentId
        && get(shiftPath(request.resource.data.toShiftId)).data.date == request.resource.data.toDate
        && request.time < offerDeadline(request.resource.data.fromDate)
        && request.time < offerDeadline(request.resource.data.toDate)
        && request.resource.data.keys().hasOnly(['id', 'fromResidentId', 'fromShiftId', 'fromDate', 'toResidentId', 'toShiftId', 'toDate', 'note', 'offerId', 'status', 'createdAt', 'notifiedNew', 'notifiedResolved']);
      allow update: if isResident() && resource.data.status == 'propuesto' && onlyChanged(['status', 'respondedAt']) && (
        // aceptar: quien la recibe, con las dos guardias cambiando de dueña en el mismo batch
        (request.resource.data.status == 'aceptado'
          && isSelf(resource.data.toResidentId)
          && request.time < offerDeadline(resource.data.fromDate)
          && request.time < offerDeadline(resource.data.toDate)
          && getAfter(shiftPath(resource.data.fromShiftId)).data.actualResidentId == resource.data.toResidentId
          && getAfter(shiftPath(resource.data.toShiftId)).data.actualResidentId == resource.data.fromResidentId)
        // rechazar: quien la recibe
        || (request.resource.data.status == 'rechazado' && isSelf(resource.data.toResidentId))
        // retirarla: quien la propuso
        || (request.resource.data.status == 'cancelado' && isSelf(resource.data.fromResidentId))
      );
      allow delete: if isAdmin();
    }

    // "Ofrezco mi guardia": cualquiera ofrece una guardia suya; otra la toma
    // (en el mismo batch que crea el cambio y pasa la guardia). Hasta el día 20.
    match /offers/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && request.resource.data.fromResidentId == request.auth.uid
        && request.resource.data.status == 'abierta'
        && request.resource.data.notifiedOpen == false
        && request.resource.data.notifiedTaken == false
        && request.time < offerDeadline(request.resource.data.date)
        && get(shiftPath(request.resource.data.shiftId)).data.actualResidentId == request.auth.uid
        && get(shiftPath(request.resource.data.shiftId)).data.date == request.resource.data.date
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['ofrezco', 'busco'])
        && request.resource.data.keys().hasOnly(['id', 'shiftId', 'date', 'fromResidentId', 'kind', 'note', 'generatesDebt', 'status', 'createdAt', 'notifiedOpen', 'notifiedTaken']);
      allow update: if isResident() && resource.data.status == 'abierta' && (
        // tomarla
        (request.resource.data.status == 'tomada'
          && request.resource.data.takenBy == request.auth.uid
          && resource.data.fromResidentId != request.auth.uid
          && request.time < offerDeadline(resource.data.date)
          && onlyChanged(['status', 'takenBy', 'takenAt', 'swapId'])
          && getAfter(/databases/$(database)/documents/swaps/$(request.resource.data.swapId)).data.offerId == id)
        // retirarla
        || (request.resource.data.status == 'cancelada'
          && (isSelf(resource.data.fromResidentId) || isAdmin())
          && onlyChanged(['status', 'cancelledAt', 'cancelledBy']))
        // "Busco cambio" resuelto: quien la publicó aceptó un intercambio
        || (request.resource.data.status == 'resuelta'
          && isSelf(resource.data.fromResidentId)
          && onlyChanged(['status', 'resolvedAt', 'tradeId'])
          && getAfter(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.status == 'aceptado')
      );
      allow delete: if isAdmin();
    }

    // Un cambio lo pide quien cede la guardia (o una admin) y lo confirma quien
    // la recibe: nadie puede pasarle su guardia a otra sin que acepte.
    match /swaps/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe()
        && ((request.resource.data.status == 'solicitado'
            && (request.resource.data.fromResidentId == request.auth.uid || isAdmin()))
          || (request.resource.data.status == 'confirmado' && 'offerId' in request.resource.data && swapFromOffer())
          || (request.resource.data.status == 'confirmado' && 'tradeId' in request.resource.data && swapFromTrade()));
      allow update: if isAdmin() || (
        (isSelf(resource.data.toResidentId) || isSelf(resource.data.fromResidentId))
        && onlyChanged(['status', 'debtSettled'])
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'solicitado'
            && (request.resource.data.status == 'rechazado'
              || (request.resource.data.status == 'confirmado' && isSelf(resource.data.toResidentId)))))
      );
      allow delete: if isAdmin();
    }

    // Solo links web (http/https): nada de "javascript:" ni otros esquemas.
    function webUrl() {
      return request.resource.data.url is string && request.resource.data.url.matches('https?://.+');
    }

    match /links/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe() && webUrl();
      allow update: if (isAdmin() || isSelf(resource.data.createdBy)) && keepsCreator() && webUrl()
        || (isResident() && onlyChanged(['pinned']));
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    // Tareas de la camada: colaborativas (cualquiera puede moverlas de estado).
    match /tasks/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe();
      allow update: if isResident() && keepsCreator();
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    match /notes/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe();
      allow update: if (isAdmin() || isSelf(resource.data.createdBy)) && keepsCreator();
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    // Historial de cambios: cada una solo puede agregar entradas a su nombre;
    // nadie (ni las admins) puede editarlas ni borrarlas. Lo leen las admins.
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isResident()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'at', 'by', 'entity', 'summary', 'changes']);
      allow update, delete: if false;
    }

    // Carriles (rotación de cada R1 por mes): los ve todo el grupo, los cargan las admins.
    match /rotations/{uid} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    // Eventos de la camada (AAARBA, cursos…).
    match /events/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe() && request.resource.data.dates is list;
      allow update: if (isAdmin() || isSelf(resource.data.createdBy)) && keepsCreator();
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    // Publicaciones de cada mes (quién tiene que confirmar sus guardias).
    match /publications/{month} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    // "¿Estás OK con tus guardias?" (id = mes_uid). Cada una responde la suya;
    // las admins las ven todas y marcan resueltos los pedidos de corrección.
    match /acks/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
      allow create, update: if isResident()
        && id == request.resource.data.month + '_' + request.auth.uid
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.notified == false
        && request.resource.data.keys().hasOnly(['id', 'month', 'residentId', 'ok', 'comment', 'at', 'notified']);
      allow update: if isAdmin() && onlyChanged(['resolvedAt', 'resolvedBy']);
      allow delete: if isAdmin();
    }

    // Pedido de cargar las guardias de un mes en HIBA 2 (lo hacen las admins;
    // el script de notificaciones avisa a las que todavía no confirmaron).
    match /hibaRequests/{month} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    // "Ya pedí mis guardias en HIBA 2" (id = mes_uid): cada una la suya.
    match /hibaAcks/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
      allow create, update: if isResident()
        && id == request.resource.data.month + '_' + request.auth.uid
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'month', 'residentId', 'at']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
    }

    // Notas del mes privadas: solo las lee y escribe quien las crea (ni las otras admins).
    match /privateNotes/{id} {
      allow read, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isResident()
        && id == request.resource.data.month + '_' + request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'month', 'ownerId', 'text', 'updatedAt']);
    }

    // Tokens de notificaciones push (doc id = token FCM del dispositivo). Cada
    // una registra solo los suyos; un token es imposible de adivinar, así que
    // se permite reasignarlo si en ese dispositivo entra otra persona. Las
    // admins los pueden listar para ver quién tiene los avisos activados.
    match /pushTokens/{token} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isResident()
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['residentId', 'device', 'updatedAt']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
    }

    // Sorteos: se sortean una sola vez (pendiente -> sorteado), con un orden
    // que contiene exactamente a los participantes, y el resultado ya no se
    // puede tocar ni borrar (solo marcar como ignorado). Los de una guardia
    // del cronograma son de admins.
    match /raffles/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && createdByMe()
        && request.resource.data.status == 'pendiente'
        && (!('linkedSlot' in request.resource.data) || isAdmin());
      allow update: if (resource.data.status == 'pendiente'
          && request.resource.data.status == 'sorteado'
          && onlyChanged(['status', 'order', 'drawnBy', 'drawnAt'])
          && request.resource.data.drawnBy == request.auth.uid
          && request.resource.data.order.size() == resource.data.participantIds.size()
          && request.resource.data.order.hasAll(resource.data.participantIds)
          && (isAdmin() || (!('linkedSlot' in resource.data) && isSelf(resource.data.createdBy))))
        // Ignorar / volver a tener en cuenta: admins o quien lo creó.
        || ((isAdmin() || isSelf(resource.data.createdBy))
          && onlyChanged(['ignored', 'ignoredBy', 'ignoredAt'])
          && request.resource.data.ignoredBy == request.auth.uid);
      // Los sorteos no se borran: se ignoran (queda el registro).
      allow delete: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function residentPath(uid) {
      return /databases/$(database)/documents/residents/$(uid);
    }

    // Tener cuenta de Auth no alcanza: hay que estar dado de alta en residents.
    function isResident() {
      return isSignedIn() && exists(residentPath(request.auth.uid));
    }

    function isAdmin() {
      return isResident() && get(residentPath(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function createdByMe() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function keepsCreator() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    // Un residente solo puede cambiar quién hace una guardia si en el mismo
    // batch queda confirmado un cambio (swap) de esa guardia del que es parte.
    function backedBySwap(shiftId) {
      let swap = getAfter(/databases/$(database)/documents/swaps/$(request.resource.data.swapId)).data;
      return swap.shiftId == shiftId
        && swap.status == 'confirmado'
        && request.resource.data.actualResidentId == swap.toResidentId
        && (isSelf(swap.toResidentId) || isSelf(swap.fromResidentId));
    }

    // El rol vive acá: nadie puede auto-promoverse a admin.
    match /residents/{uid} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSelf(uid) && onlyChanged(['name', 'shortName', 'email', 'birthday']));
    }

    match /monthConfigs/{id} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    match /calendarDays/{id} {
      allow read: if isResident();
      allow write: if isAdmin();
    }

    match /scheduleDrafts/{id} {
      allow read, write: if isAdmin();
    }

    match /shifts/{id} {
      allow read: if isResident();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isResident() && onlyChanged(['actualResidentId', 'swapId', 'updatedAt']) && backedBySwap(id))
        || (isSelf(resource.data.actualResidentId) && onlyChanged(['slept', 'updatedAt']));
    }

    // Pedidos: los ve todo el grupo. Cada una maneja los suyos mientras están
    // pendientes; las admins pueden cargarlos en nombre de otra persona.
    match /requests/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && (request.resource.data.residentId == request.auth.uid || isAdmin())
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.status == 'pendiente';
      allow update: if isAdmin() || (
        isSelf(resource.data.residentId)
        && request.resource.data.residentId == resource.data.residentId
        && resource.data.status == 'pendiente'
        && request.resource.data.status == 'pendiente'
      );
      allow delete: if isAdmin() || (isSelf(resource.data.residentId) && resource.data.status == 'pendiente');
    }

    // Feedback post-guardia (doc id = id de la guardia): solo autor + admins.
    // Toda query de una no-admin tiene que filtrar por su residentId.
    match /feedback/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.residentId == request.auth.uid);
      allow create: if isResident() && request.resource.data.residentId == request.auth.uid;
      allow update: if isAdmin() || (
        isSelf(resource.data.residentId) && request.resource.data.residentId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /swaps/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe() && request.resource.data.status == 'solicitado';
      allow update: if isAdmin() || (
        (isSelf(resource.data.toResidentId) || isSelf(resource.data.fromResidentId))
        && onlyChanged(['status', 'debtSettled'])
      );
      allow delete: if isAdmin();
    }

    match /links/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe();
      allow update: if (isAdmin() || isSelf(resource.data.createdBy)) && keepsCreator()
        || (isResident() && onlyChanged(['pinned']));
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    // Tareas de la camada: colaborativas (cualquiera puede moverlas de estado).
    match /tasks/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe();
      allow update: if isResident() && keepsCreator();
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    match /notes/{id} {
      allow read: if isResident();
      allow create: if isResident() && createdByMe();
      allow update: if (isAdmin() || isSelf(resource.data.createdBy)) && keepsCreator();
      allow delete: if isAdmin() || isSelf(resource.data.createdBy);
    }

    // Historial de cambios: cada una solo puede agregar entradas a su nombre;
    // nadie (ni las admins) puede editarlas ni borrarlas. Lo leen las admins.
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isResident()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'at', 'by', 'entity', 'summary', 'changes']);
      allow update, delete: if false;
    }

    // Sorteos: se sortean una sola vez (pendiente -> sorteado), con un orden
    // que contiene exactamente a los participantes, y el resultado ya no se
    // puede tocar ni borrar. Los de una guardia del cronograma son de admins.
    match /raffles/{id} {
      allow read: if isResident();
      allow create: if isResident()
        && createdByMe()
        && request.resource.data.status == 'pendiente'
        && (!('linkedSlot' in request.resource.data) || isAdmin());
      allow update: if resource.data.status == 'pendiente'
        && request.resource.data.status == 'sorteado'
        && onlyChanged(['status', 'order', 'drawnBy', 'drawnAt'])
        && request.resource.data.drawnBy == request.auth.uid
        && request.resource.data.order.size() == resource.data.participantIds.size()
        && request.resource.data.order.hasAll(resource.data.participantIds)
        && (isAdmin() || (!('linkedSlot' in resource.data) && isSelf(resource.data.createdBy)));
      allow delete: if resource.data.status == 'pendiente'
        && (isAdmin() || isSelf(resource.data.createdBy));
    }
  }
}

# Copiá este archivo a .env (no se commitea) con los valores de tu proyecto
# Firebase: Console > Configuración del proyecto > Tus apps > Web app > SDK config.
# No son secretos (identifican el proyecto), pero cada quien usa el suyo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
